# Server-side only. Do not prefix these with VITE_. Never commit .env.
SYNVIX_PORT=4310
SYNVIX_DB=.local/synvix.sqlite
# Generate two different random tokens, at least 32 characters each.
SYNVIX_VIEW_TOKEN=
SYNVIX_INGEST_TOKEN=
CURSOR_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Exact owner/repo allowlist for GitHub webhooks, comma separated.
GITHUB_REPOSITORIES=
SYNVIX_POLL_MS=30000
SYNVIX_MAX_AGENTS=100
SYNVIX_CURSOR_STREAMS=5
# Optional HTTPS reverse-proxy origin(s); direct server remains loopback-only.
SYNVIX_ORIGINS=
# Optional multi-tenant JSON; when set, overrides the single-tenant token config.
# SYNVIX_TENANTS_FILE=synvix.tenants.json
